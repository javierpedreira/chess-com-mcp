# Chess.com asks API consumers to send a descriptive User-Agent that identifies
# the app and ideally includes a contact (email or repo URL). Requests without a
# proper User-Agent may be rejected with HTTP 403.
#
# Copy this file to `.env.local` for local development, and set the same variable
# in your Vercel project settings for production.
CHESS_API_USER_AGENT="chess-com-mcp/1.0 (+https://github.com/<you>/chess-com-mcp; contact: you@example.com)"
